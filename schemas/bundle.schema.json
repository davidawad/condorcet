{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assaymark.invalid/schemas/bundle/v1.json",
  "title": "assaymark Bundle v1 (fact-adapter interchange)",
  "description": "What a fact adapter hands the engine: claims, the exhibits that bear on them, weighted support/contradict/undercut links, declared constraints and independence clusters. Pure data. The engine commits to no domain: unknown fields are rejected so domain rules cannot leak across the seam.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "adapter", "claims", "links"],
  "properties": {
    "schema": {"const": "assaymark/bundle/v1"},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "description": "Source revision the bundle was computed against, e.g. git:<sha>. Used as expected-revision on write-back."}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain": {"type": "string"},
        "entities": {"type": "array", "items": {"type": "string"}},
        "question": {"type": ["string", "null"]}
      }
    },
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "exhibits": {"type": "array", "items": {"$ref": "#/$defs/exhibit"}},
    "links": {"type": "array", "items": {"$ref": "#/$defs/link"}},
    "constraints": {"type": "array", "items": {"$ref": "#/$defs/constraint"}},
    "clusters": {"type": "array", "items": {"$ref": "#/$defs/cluster"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "description": "Opaque, adapter-minted."},
    "probability": {"type": "number", "minimum": 0, "maximum": 1},
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "text": {"type": "string"},
        "prior": {"$ref": "#/$defs/probability"},
        "p_hint": {"$ref": "#/$defs/probability", "description": "The adapter's own scalar probability, used when this claim is a defeater with no evidence of its own in the bundle."},
        "noticed": {"type": "boolean", "default": false, "description": "Taken as true: a hard unit clause."},
        "about": {"type": "array", "items": {"type": "string"}}
      }
    },
    "exhibit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reading"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "specimen": {"type": "string"},
        "locator": {"type": "string"},
        "reading": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claim"],
          "properties": {
            "claim": {"$ref": "#/$defs/id"},
            "purpose": {"type": "string"}
          }
        },
        "clusters": {"type": "array", "items": {"type": "string"}}
      }
    },
    "weight": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["reliability"],
          "properties": {"reliability": {"type": "number", "exclusiveMinimum": 0.5, "exclusiveMaximum": 1}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["llr"],
          "properties": {"llr": {"type": "number", "exclusiveMinimum": 0, "description": "Natural-log likelihood ratio."}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["unweighted"],
          "properties": {"unweighted": {"const": true}}
        }
      ]
    },
    "link": {
      "type": "object",
      "required": ["id", "kind", "from", "to"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["support", "contradict", "undercut"]},
        "from": {"$ref": "#/$defs/id"},
        "to": {"$ref": "#/$defs/id", "description": "A claim id for support/contradict; a link id for undercut."},
        "basis": {"type": "string"}
      },
      "oneOf": [
        {
          "properties": {"kind": {"enum": ["support", "contradict"]}, "weight": {"$ref": "#/$defs/weight"}, "id": true, "from": true, "to": true, "basis": true},
          "required": ["weight"],
          "additionalProperties": false
        },
        {
          "properties": {"kind": {"const": "undercut"}, "strength": {"$ref": "#/$defs/probability"}, "id": true, "from": true, "to": true, "basis": true},
          "required": ["strength"],
          "additionalProperties": false
        }
      ]
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "claims", "mode"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["excludes", "implies", "equiv", "exactly_one", "at_most_one", "at_least_one"]},
        "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "mode": {
          "oneOf": [
            {"const": "hard"},
            {"type": "object", "additionalProperties": false, "required": ["soft"], "properties": {"soft": {"type": "number", "exclusiveMinimum": 0, "description": "Log-odds penalty."}}}
          ]
        },
        "basis": {"type": "string"}
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "rho"],
      "properties": {
        "key": {"type": "string"},
        "rho": {"type": "number", "minimum": 0, "maximum": 1},
        "basis": {"type": "string"}
      }
    }
  }
}
