{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://condorcet.invalid/schemas/composer/v1.json",
  "title": "condorcet composer declaration v1",
  "description": "A composer is a declared, versioned, swappable technique for composing evidence (logical, argumentation or probabilistic). One file per composer at composers/<name>/composer.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "family", "title", "inputs", "outputs", "assumptions", "cost", "exactness", "deterministic", "engine"],
  "properties": {
    "$schema": {"type": "string"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+$", "description": "Integer major; the id is composer:<name>@<version>."},
    "family": {"enum": ["logical", "argumentation", "probabilistic", "baseline"]},
    "title": {"type": "string"},
    "reference": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cite"],
        "properties": {"cite": {"type": "string"}, "doi": {"type": "string"}, "url": {"type": "string"}}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires"],
      "properties": {
        "requires": {"type": "array", "items": {"enum": ["claims", "exhibits", "links", "constraints", "clusters"]}},
        "optional": {"type": "array", "items": {"enum": ["claims", "exhibits", "links", "constraints", "clusters"]}},
        "weights": {"type": "array", "items": {"enum": ["reliability", "llr", "unweighted"]}},
        "link_kinds": {"type": "array", "items": {"enum": ["support", "contradict", "undercut"]}}
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "per"],
        "properties": {
          "name": {"type": "string"},
          "type": {"enum": ["probability", "number", "boolean", "label", "set", "core", "model"]},
          "per": {"enum": ["claim", "claim_set", "link", "bundle"]}
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {"id": {"type": "string"}, "text": {"type": "string"}}
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class"],
      "properties": {
        "class": {"type": "string", "description": "Complexity class, e.g. P, NP-complete, #P-hard."},
        "typical": {"type": "string"},
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_vars": {"type": "integer", "minimum": 1},
            "timeout_ms": {"type": "integer", "minimum": 1},
            "max_cores": {"type": "integer", "minimum": 1}
          }
        },
        "on_exceed": {"type": "string", "pattern": "^(fail|skip|fallback:[a-z][a-z0-9-]*)$"}
      }
    },
    "exactness": {"enum": ["exact", "approximate", "heuristic"]},
    "deterministic": {"type": "boolean"},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["builtin", "subprocess"]},
        "impl": {"type": "string"},
        "bin": {"type": "string"},
        "alternates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": {"enum": ["builtin", "subprocess"]},
              "impl": {"type": "string"},
              "bin": {"type": "string"},
              "license": {"type": "string"}
            }
          }
        }
      }
    },
    "params": {"type": "object", "description": "A JSON Schema (object) for this composer's parameters."}
  }
}
